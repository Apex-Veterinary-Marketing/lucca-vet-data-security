---
// Lucca header — the live Webflow navbar (Arfito template "navbar-wrapper-three"), same markup and
// class names, styled by styles/site.css. Menus come from data/navigation.ts.
// Behaviour (webflow.js + IX2 on the live site) lives in WebflowInteractions.astro:
//   - desktop: dropdowns open on hover (IX2 "Nav Dropdown V2 Open/Close"), click toggles too
//   - ≤991px ("medium" collapse): the hamburger slides the menu in from the left (over-left, 400ms)
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { headerNav, contactHref } from "../data/navigation";
import luccaLogo from "../assets/brand/lucca-logo.png";
import luccaWebclip from "../assets/brand/lucca-webclip.png";
import { getSiteInfo } from "../lib/data/site";
import { phoneHref } from "../lib/utils/phone";

export interface Props {
  /** Adds the phone number, labelled "Talk to a technician", beside Contact us (and in the mobile menu). */
  phone?: boolean;
}
const site = await getSiteInfo();
const telHref = Astro.props.phone ? phoneHref(site) : undefined;

// Without the GitHub Pages base path (astro.config.mjs PAGES_BASE), if any.
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.slice(basePath && Astro.url.pathname.startsWith(basePath) ? basePath.length : 0).replace(/\/$/, "") || "/";
const isCurrent = (href: string) => (href.replace(/\/$/, "") || "/") === path;
---

<header class="header static">
  <div data-collapse="medium" data-animation="over-left" data-duration="400" role="banner" class="navbar-menu-container w-nav">
    <div class="w-layout-blockcontainer main-container w-container">
      <div class="navbar-wrapper-three">
        <a href="/" aria-current={path === "/" ? "page" : undefined} class:list={["navbar-brand-logo w-nav-brand", { "w--current": path === "/" }]}>
          <Image src={luccaLogo} alt="Lucca Veterinary Data Security" class="header-logo" loading="eager" />
        </a>
        <nav role="navigation" class="nav-menu-wrapper-three w-nav-menu" id="site-nav">
          <div class="nav-menu-three">
            <ul role="list" class="nav-menu-block w-list-unstyled">
              <li class="nav-menu-item mobile">
                <a href="/" class:list={["navbar-brand-logo w-nav-brand", { "w--current": path === "/" }]}>
                  <Image src={luccaWebclip} alt="Lucca Veterinary Data Security" class="header-logo" />
                </a>
              </li>
              {headerNav.map((item) =>
                item.links ? (
                  <li class="nav-menu-item">
                    <div class="nav-dropdown w-dropdown" data-dropdown>
                      <div class="nav-dropdown-toggle w-dropdown-toggle">
                        <a href={item.href} class="nav-menu-wrap gap-right-7px w-inline-block">
                          <div class="nav-bottom-border move-right"></div>
                          <div class="nav-menu-text">{item.label}</div>
                        </a>
                        <button type="button" class="nav-dropdown-icon-v2 w-embed" aria-expanded="false" aria-label={`${item.label} menu`}>
                          <Icon name="chevron" />
                        </button>
                      </div>
                      <nav class="nav-dropdown-list-v2 w-dropdown-list">
                        <div class="nav-dropdown-wrap">
                          {item.links.map((link) =>
                            link.children ? (
                              <div class="nav-dropdown-link-block dropdown">
                                <div class="nav-dropdown-link inner-dropdown w-dropdown">
                                  <div class="dropdown-toggle w-dropdown-toggle">
                                    <a href={link.href} class="link-block-inner-dropdown w-inline-block">
                                      <div class="dropdown-border-line"></div>
                                      <div class="icon-2 w-icon-dropdown-toggle" aria-hidden="true"></div>
                                      <div class="text-block">{link.label}</div>
                                    </a>
                                  </div>
                                  <nav class="dropdown-list w-dropdown-list">
                                    <div class="dropdown-list-wrapper">
                                      {link.children.map((child) => (
                                        <a href={child.href} class="dropdown-link w-dropdown-link">{child.label}</a>
                                      ))}
                                    </div>
                                  </nav>
                                </div>
                              </div>
                            ) : (
                              <a href={link.href} class="nav-dropdown-link-block w-inline-block">
                                <div class="dropdown-border-line"></div>
                                <div class="nav-dropdown-link">{link.label}</div>
                              </a>
                            )
                          )}
                        </div>
                      </nav>
                    </div>
                  </li>
                ) : (
                  <li class="nav-menu-item">
                    <div class="nav-menu-wrap">
                      <div class="nav-bottom-border"></div>
                      <a
                        href={item.href}
                        aria-current={isCurrent(item.href) ? "page" : undefined}
                        class:list={["nav-menu-link", { "w--current": isCurrent(item.href) }]}
                      >{item.label}</a>
                    </div>
                  </li>
                )
              )}
              {telHref && (
                <li class="nav-menu-item mobile">
                  <a href={telHref} class="header-phone" aria-label={`Talk to a technician: ${site.phoneNumber}`}>
                    <span class="header-phone-icon" aria-hidden="true"><Icon name="call" /></span>
                    <span class="header-phone-text">
                      <span class="header-phone-label">Talk to a technician</span>
                      <span class="header-phone-number">{site.phoneNumber}</span>
                    </span>
                  </a>
                </li>
              )}
              <li class="nav-menu-item mobile">
                <div class="header-buttton-block">
                  <div class="primary-button-block">
                    <div class="button-icon left">
                      <div class="button-image-icon w-embed"><Icon name="call" /></div>
                    </div>
                    <a href={contactHref} class="primary-button-link w-inline-block">
                      <div class="button-content"><div class="button-color">Contact us</div></div>
                    </a>
                    <div class="button-icon right">
                      <div class="button-image-icon w-embed"><Icon name="call" /></div>
                    </div>
                  </div>
                </div>
              </li>
            </ul>
          </div>
        </nav>
        <div class:list={["header-buttton-block desktop", { "has-phone": telHref }]}>
          {telHref && (
            <a href={telHref} class="header-phone" aria-label={`Talk to a technician: ${site.phoneNumber}`}>
              <span class="header-phone-icon" aria-hidden="true"><Icon name="call" /></span>
              <span class="header-phone-text">
                <span class="header-phone-label">Talk to a technician</span>
                <span class="header-phone-number">{site.phoneNumber}</span>
              </span>
            </a>
          )}
          <div class="primary-button-block">
            <div class="button-icon left">
              <div class="button-image-icon white-icon w-embed"><Icon name="arrow" /></div>
            </div>
            <a href={contactHref} class="primary-button-link w-inline-block">
              <div class="button-content"><div class="button-color">Contact us</div></div>
            </a>
            <div class="button-icon right">
              <div class="button-image-icon white-icon w-embed"><Icon name="arrow" /></div>
            </div>
          </div>
        </div>
        <button type="button" class="menu-button w-nav-button" aria-label="Menu" aria-controls="site-nav" aria-expanded="false">
          <div class="hamburger-icon w-icon-nav-menu" aria-hidden="true"></div>
        </button>
      </div>
    </div>
  </div>
</header>
