---
// Lucca footer — the live Webflow footer, same markup and class names (styled by styles/site.css):
// the "Complete Ransomware Protection" CTA band, the menu columns (data/navigation.ts), the
// "Struggling with Your Clinic's IT?" pop-up and the floating Google reviews badge.
//   - Pop-up: shown 3s after load unless the `alert` cookie is set (1 day) — the live site's
//     custom code; closed by the backdrop or the × (IX2 "Close Save Big Popup").
//   - Reviews badge: the agency widget API fills #reviews-container (site.googleWidgetId);
//     "4.8 ★★★★★" is the live badge's own fallback text.
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import ButtonPrimary from "./ButtonPrimary.astro";
import { footerMenus } from "../data/navigation";
import { getSiteInfo } from "../lib/data/site";
import { getAllSocialLinks } from "../lib/data/socialLinks";
import luccaLogo from "../assets/brand/lucca-logo.png";

const site = await getSiteInfo();
// Live footer order: Facebook, then LinkedIn (its X and Instagram icons are hidden placeholders).
const order = ["facebook", "linkedin"];
const socials = (await getAllSocialLinks())
  .filter((s) => order.includes(s.data.icon))
  .sort((a, b) => order.indexOf(a.data.icon) - order.indexOf(b.data.icon));
const socialLabel: Record<string, string> = { facebook: "Facebook", linkedin: "LinkedIn" };
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const year = new Date().getFullYear();
---

<footer class="footer">
  <section class="service-section-v2 section-y-axis-gap dark-bg small-padding">
    <div class="w-layout-blockcontainer main-container no-margin-bottom w-container">
      <div class="display-flex-vertical">
        <div class="section-title-block margin-top-15px padding-bottom width-75">
          <h2 class="section-title text-white center-text" data-ix="text">Complete Ransomware Protection Starting at $30 Per Month</h2>
        </div>
        <div class="service-top-button-block width-20" data-ix="slide-up" data-ix-delay="300">
          <ButtonPrimary href="/your-cyber-security-mindset" label="Learn More" white />
        </div>
      </div>
    </div>
  </section>
  <div class="footer-inner-block">
    <div class="w-layout-blockcontainer main-container w-container">
      <div class="footer-wrapper">
        <div class="footer-upper-content-block">
          <div class="footer-content-single-block">
            <a href="/" aria-current={path === "/" ? "page" : undefined} class:list={["footer-logo-link w-inline-block", { "w--current": path === "/" }]}>
              <Image src={luccaLogo} alt={site.practiceName} class="footer-logo" />
            </a>
          </div>
          {footerMenus.map((menu) => (
            <div class="footer-menu-block">
              {menu.href ? (
                <a href={menu.href} class="w-inline-block"><h3 class="footer-menu-title">{menu.title}</h3></a>
              ) : (
                <h3 class="footer-menu-title">{menu.title}</h3>
              )}
              <div class="footer-menu-wrap">
                {menu.cmsList ? (
                  <div class="collection-list-wrapper w-dyn-list">
                    <div role="list" class="collection-list w-dyn-items">
                      {menu.links.map((link) => (
                        <div role="listitem" class="collection-item w-dyn-item"><a href={link.href} class="footer-menu-link">{link.label}</a></div>
                      ))}
                    </div>
                  </div>
                ) : (
                  menu.links.map((link) => <a href={link.href} class="footer-menu-link">{link.label}</a>)
                )}
              </div>
            </div>
          ))}
        </div>
        <div class="footer-lower-content-block">
          <div class="footer-copyright-text">© {year} {site.practiceName}. <a href="/terms-of-use">Terms Of Use</a></div>
          <div class="footer-social-block">
            {socials.map((s) => (
              <a aria-label={socialLabel[s.data.icon]} href={s.data.link} target="_blank" rel="noopener" class="social-link w-inline-block">
                <div class="social-icon w-embed"><Icon name={s.data.icon as "facebook" | "linkedin"} /></div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="pop-up-wrapper" class="pop-up-wrapper" role="dialog" aria-modal="true" aria-labelledby="pop-up-header">
    <div class="pop-up-back" data-popup-close></div>
    <div class="pop-up-box">
      <button type="button" class="pop-up-exit-button" data-popup-close aria-label="Close">
        <img width="18" alt="" src="/images/site/exit-icon.svg" />
      </button>
      <div class="pop-up-text-box">
        <h2 class="pop-up-header" id="pop-up-header">Struggling with Your Clinic’s IT?</h2>
        <p class="pop-up-paragraph">We’ve got the solution! Discover how clinics are saving big on IT services while boosting efficiency. Limited spots available—schedule your FREE Discovery Call today!</p>
      </div>
      <a href="/book-a-call" class="button w-button">Learn More</a>
    </div>
  </div>

  {site.addressLink && (
    <a href={site.addressLink} target="_blank" rel="noopener" class="google-reviews-widget-2 w-inline-block">
      <img alt="" src="/images/site/google-icon.png" class="grw-google" />
      <div class="w-embed w-script">
        <div id="reviews-container" data-google-widget-id={site.googleWidgetId}></div>
      </div>
      <div class="review-box-rating">{site.googleRating} ★★★★★</div>
      <div class="grw-text">Our Reviews</div>
    </a>
  )}
</footer>

<script>
  // Google reviews badge — the live site's custom code: the agency widget API returns the badge HTML.
  const container = document.getElementById("reviews-container");
  const id = container?.dataset.googleWidgetId;
  if (container && id) {
    fetch(`https://vetmarketing.googlewidget.com/api/reviews/${id}`)
      .then((r) => r.text())
      .then((html) => {
        container.innerHTML = html;
        // Anything else on the page that shows the rating ([data-google-rating], e.g. a trust card)
        // gets the same live number the badge shows; the server-rendered fallback stays otherwise.
        const rating = parseFloat(container.textContent ?? "");
        if (rating > 0) document.querySelectorAll<HTMLElement>("[data-google-rating]").forEach((el) => { el.textContent = rating.toFixed(1); });
      })
      .catch((err) => console.error("Error fetching reviews:", err));
  }
</script>
