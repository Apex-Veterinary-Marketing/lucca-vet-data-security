---
// Lucca: /blog — the live Webflow blog page (src/webflow/blog-index.html) with its collection list filled from
// src/content/blog: the 100 newest posts by Created On, as the live list shows (its limit is 100).
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPosts } from "../../lib/data/blog";
import { getSiteInfo } from "../../lib/data/site";
import { webflowPages, prepare } from "../../lib/webflow";
import { indexTemplate, card, BLOG_LIMIT } from "../../lib/webflowBlog";

const meta = webflowPages["/blog"];
const site = await getSiteInfo();
const posts = (await getAllPosts()).slice(0, BLOG_LIMIT);
const cards = (await Promise.all(posts.map((p) => card(p)))).join("");
const html = prepare(indexTemplate.replace("<!--WF:POSTS-->", cards), site);
---

<BaseLayout title={meta.title} titleTemplate="full" description={meta.description} wfPageId={meta.pageId} breadcrumb="Blog">
  <Fragment set:html={html} />
</BaseLayout>
